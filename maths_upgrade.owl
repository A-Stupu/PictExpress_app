    <!-- CLASSES DISJOINTES -->
    <DisjointClasses><Class IRI="#Actions"/><Class IRI="#MathematicalConcepts"/><Class IRI="#Needs"/><Class IRI="#Person"/><Class IRI="#SchoolMaterial"/></DisjointClasses>
