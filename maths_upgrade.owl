    <!-- HIERARCHIE ET REGLES D'INFERENCE -->

    <!-- Règle : Tracer un cercle implique Compas et Crayon -->
    <SubClassOf>
        <ObjectIntersectionOf>
            <Class IRI="#Draw"/>
            <ObjectSomeValuesFrom>
                <ObjectProperty IRI="#appliesToConcept"/>
                <Class IRI="#Circle"/>
            </ObjectSomeValuesFrom>
        </ObjectIntersectionOf>
        <ObjectIntersectionOf>
            <ObjectSomeValuesFrom><ObjectProperty IRI="#usesSupply"/><Class IRI="#Compass"/></ObjectSomeValuesFrom>
            <ObjectSomeValuesFrom><ObjectProperty IRI="#usesSupply"/><Class IRI="#Pencil"/></ObjectSomeValuesFrom>
        </ObjectIntersectionOf>
    </SubClassOf>

    <!-- Règle : Mesurer une forme géométrique implique la Règle -->
    <SubClassOf>
        <ObjectIntersectionOf>
            <Class IRI="#Mesure"/>
            <ObjectSomeValuesFrom>
                <ObjectProperty IRI="#appliesToConcept"/>
                <Class IRI="#GeometricShape"/>
            </ObjectSomeValuesFrom>
        </ObjectIntersectionOf>
        <ObjectSomeValuesFrom><ObjectProperty IRI="#usesSupply"/><Class IRI="#Ruler"/></ObjectSomeValuesFrom>
    </SubClassOf>

    <!-- Règle : Calculer implique Calculatrice, Mains ou Mental -->
    <SubClassOf>
        <Class IRI="#Calculate"/>
        <ObjectSomeValuesFrom>
            <ObjectProperty IRI="#usesSupply"/>
            <ObjectUnionOf>
                <Class IRI="#Calculator"/><Class IRI="#Hands"/><Class IRI="#Mind"/>
            </ObjectUnionOf>
        </ObjectSomeValuesFrom>
    </SubClassOf>

    <!-- Règle : Écrire implique Crayon et Cahier -->
    <SubClassOf>
        <Class IRI="#Write"/>
        <ObjectIntersectionOf>
            <ObjectSomeValuesFrom><ObjectProperty IRI="#usesSupply"/><Class IRI="#Pencil"/></ObjectSomeValuesFrom>
            <ObjectSomeValuesFrom><ObjectProperty IRI="#usesSupply"/><Class IRI="#Notebook"/></ObjectSomeValuesFrom>
        </ObjectIntersectionOf>
    </SubClassOf>

    <!-- Règle : Tracer Triangle/Carré implique Equerre -->
    <SubClassOf>
        <ObjectIntersectionOf>
            <Class IRI="#Draw"/>
            <ObjectUnionOf><Class IRI="#Triangle"/><Class IRI="#Square"/></ObjectUnionOf>
        </ObjectIntersectionOf>
        <ObjectSomeValuesFrom><ObjectProperty IRI="#usesSupply"/><Class IRI="#SetSquare"/></ObjectSomeValuesFrom>
    </SubClassOf>

    <!-- Structure des classes (Hiérarchie de base) -->
    <SubClassOf><Class IRI="#Addition"/><Class IRI="#MathOperation"/></SubClassOf>
