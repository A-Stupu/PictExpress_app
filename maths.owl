    <!-- Math operations and concepts -->
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Addition</IRI>
        <Literal xml:lang="fr">addition</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Subtraction</IRI>
        <Literal xml:lang="fr">soustraction</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
