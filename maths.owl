    </AnnotationAssertion>

    <!-- Geometric shapes -->
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Circle</IRI>
        <Literal xml:lang="fr">cercle</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Square</IRI>
        <Literal xml:lang="fr">carré</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Triangle</IRI>
        <Literal xml:lang="fr">triangle</Literal>
    </AnnotationAssertion>

    <!-- School materials -->
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Compass</IRI>
        <Literal xml:lang="fr">compas</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Pencil</IRI>
        <Literal xml:lang="fr">crayon</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Eraser</IRI>
        <Literal xml:lang="fr">gomme</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Ruler</IRI>
        <Literal xml:lang="fr">règle</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#SetSquare</IRI>
        <Literal xml:lang="fr">équerre</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Notebook</IRI>
        <Literal xml:lang="fr">cahier</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Calculator</IRI>
        <Literal xml:lang="fr">calculatrice</Literal>
