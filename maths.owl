<?xml version="1.0"?>
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="http://www.pictexpress.org/ontologies/math.owl"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     ontologyIRI="http://www.pictexpress.org/ontologies/math.owl">
    <Prefix name="" IRI="http://www.pictexpress.org/ontologies/math.owl/"/>
    <Prefix name="owl" IRI="http://www.w3.org/2002/07/owl#"/>
    <Prefix name="rdf" IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
    <Prefix name="xml" IRI="http://www.w3.org/XML/1998/namespace"/>
    <Prefix name="xsd" IRI="http://www.w3.org/2001/XMLSchema#"/>
    <Prefix name="rdfs" IRI="http://www.w3.org/2000/01/rdf-schema#"/>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal>A math ontology that describes various concepts, actions and school material needed in this subject.</Literal>
    </Annotation>

    <!-- =================================================================
         CLASS DECLARATIONS
         ================================================================= -->

    <!-- Top-level disjoint categories -->
    <Declaration><Class IRI="#Actions"/></Declaration>
    <!-- DESIGN: CalculationMethod is a new top-level class for cognitive/bodily means of
         calculation (Hands, Mind). They are not physical school supplies (SchoolMaterial)
         and not actions themselves, so a dedicated sibling category avoids a mis-classification
         that would make the CalculationTool -> SchoolMaterial branch internally inconsistent. -->
    <Declaration><Class IRI="#CalculationMethod"/></Declaration>
    <Declaration><Class IRI="#MathematicalConcept"/></Declaration>
    <Declaration><Class IRI="#Needs"/></Declaration>
    <Declaration><Class IRI="#Person"/></Declaration>
    <Declaration><Class IRI="#SchoolMaterial"/></Declaration>

    <!-- Person subtypes -->
    <Declaration><Class IRI="#Assistant"/></Declaration>
    <Declaration><Class IRI="#Student"/></Declaration>
    <Declaration><Class IRI="#Teacher"/></Declaration>

    <!-- Actions subtypes -->
    <Declaration><Class IRI="#ManualAction"/></Declaration>
    <Declaration><Class IRI="#MathAction"/></Declaration>
    <!-- MathAction subtypes -->
    <Declaration><Class IRI="#Calculate"/></Declaration>
    <Declaration><Class IRI="#Count"/></Declaration>
    <Declaration><Class IRI="#Draw"/></Declaration>
    <Declaration><Class IRI="#Measure"/></Declaration>
    <!-- ManualAction subtypes -->
    <Declaration><Class IRI="#Cut"/></Declaration>
    <Declaration><Class IRI="#Erase"/></Declaration>
    <Declaration><Class IRI="#Write"/></Declaration>

    <!-- SchoolMaterial subtypes -->
    <Declaration><Class IRI="#BasicTool"/></Declaration>
    <Declaration><Class IRI="#CalculationTool"/></Declaration>
    <Declaration><Class IRI="#GeometryTool"/></Declaration>
    <!-- BasicTool subtypes -->
    <Declaration><Class IRI="#Eraser"/></Declaration>
    <Declaration><Class IRI="#Notebook"/></Declaration>
    <Declaration><Class IRI="#Pencil"/></Declaration>
    <!-- CalculationTool subtypes -->
    <Declaration><Class IRI="#Calculator"/></Declaration>
    <!-- GeometryTool subtypes -->
    <Declaration><Class IRI="#Compass"/></Declaration>
    <Declaration><Class IRI="#Ruler"/></Declaration>
    <Declaration><Class IRI="#SetSquare"/></Declaration>

    <!-- CalculationMethod subtypes -->
    <Declaration><Class IRI="#Hands"/></Declaration>
    <Declaration><Class IRI="#Mind"/></Declaration>

    <!-- MathematicalConcept subtypes -->
    <Declaration><Class IRI="#GeometricShape"/></Declaration>
    <Declaration><Class IRI="#Magnitude"/></Declaration>
    <Declaration><Class IRI="#MathOperation"/></Declaration>
    <Declaration><Class IRI="#Number"/></Declaration>
    <!-- GeometricShape subtypes -->
    <Declaration><Class IRI="#Circle"/></Declaration>
    <Declaration><Class IRI="#Square"/></Declaration>
    <Declaration><Class IRI="#Triangle"/></Declaration>
    <!-- Magnitude subtypes -->
    <Declaration><Class IRI="#Bigger"/></Declaration>
    <Declaration><Class IRI="#Equal"/></Declaration>
    <Declaration><Class IRI="#Smaller"/></Declaration>
    <!-- MathOperation subtypes -->
    <Declaration><Class IRI="#Addition"/></Declaration>
    <Declaration><Class IRI="#Subtraction"/></Declaration>

    <!-- Needs subtypes -->
    <Declaration><Class IRI="#HelpNeed"/></Declaration>
    <Declaration><Class IRI="#MentalNeed"/></Declaration>
    <Declaration><Class IRI="#ValidationNeed"/></Declaration>
    <!-- HelpNeed subtypes -->
    <Declaration><Class IRI="#DoNotUnderstand"/></Declaration>
    <!-- MentalNeed subtypes -->
    <Declaration><Class IRI="#NeedBreak"/></Declaration>
    <Declaration><Class IRI="#Tired"/></Declaration>
    <Declaration><Class IRI="#TooMuchNoise"/></Declaration>
    <!-- ValidationNeed subtypes -->
    <Declaration><Class IRI="#IFinish"/></Declaration>
    <Declaration><Class IRI="#IUnderstand"/></Declaration>
    <Declaration><Class IRI="#IsItGood"/></Declaration>

    <!-- =================================================================
         OBJECT PROPERTY DECLARATIONS
         ================================================================= -->
    <Declaration><ObjectProperty IRI="#appliesToConcept"/></Declaration>
    <Declaration><ObjectProperty IRI="#isAppliedIn"/></Declaration>
    <Declaration><ObjectProperty IRI="#isPerformedBy"/></Declaration>
    <Declaration><ObjectProperty IRI="#isRequestedBy"/></Declaration>
    <Declaration><ObjectProperty IRI="#isUsedIn"/></Declaration>
    <Declaration><ObjectProperty IRI="#performsAction"/></Declaration>
    <Declaration><ObjectProperty IRI="#requestHelpFrom"/></Declaration>
    <Declaration><ObjectProperty IRI="#usesSupply"/></Declaration>

    <!-- =================================================================
         ANNOTATION PROPERTY DECLARATIONS
         ================================================================= -->
    <!-- DESIGN: arasaacId stores the integer ID from the ARASAAC pictogram database
         (https://arasaac.org). Used by OntologyService to resolve pictogram URLs
         without a runtime API call. -->
    <Declaration><AnnotationProperty IRI="#arasaacId"/></Declaration>

    <!-- =================================================================
         CLASS HIERARCHY (SubClassOf)
         ================================================================= -->

    <!-- Person -->
    <SubClassOf><Class IRI="#Assistant"/><Class IRI="#Person"/></SubClassOf>
    <SubClassOf><Class IRI="#Student"/><Class IRI="#Person"/></SubClassOf>
    <SubClassOf><Class IRI="#Teacher"/><Class IRI="#Person"/></SubClassOf>

    <!-- Actions -->
    <SubClassOf><Class IRI="#ManualAction"/><Class IRI="#Actions"/></SubClassOf>
    <SubClassOf><Class IRI="#MathAction"/><Class IRI="#Actions"/></SubClassOf>
    <SubClassOf><Class IRI="#Calculate"/><Class IRI="#MathAction"/></SubClassOf>
    <SubClassOf><Class IRI="#Count"/><Class IRI="#MathAction"/></SubClassOf>
    <SubClassOf><Class IRI="#Draw"/><Class IRI="#MathAction"/></SubClassOf>
    <SubClassOf><Class IRI="#Measure"/><Class IRI="#MathAction"/></SubClassOf>
    <SubClassOf><Class IRI="#Cut"/><Class IRI="#ManualAction"/></SubClassOf>
    <SubClassOf><Class IRI="#Erase"/><Class IRI="#ManualAction"/></SubClassOf>
    <SubClassOf><Class IRI="#Write"/><Class IRI="#ManualAction"/></SubClassOf>

    <!-- SchoolMaterial -->
    <SubClassOf><Class IRI="#BasicTool"/><Class IRI="#SchoolMaterial"/></SubClassOf>
    <SubClassOf><Class IRI="#CalculationTool"/><Class IRI="#SchoolMaterial"/></SubClassOf>
    <SubClassOf><Class IRI="#GeometryTool"/><Class IRI="#SchoolMaterial"/></SubClassOf>
    <SubClassOf><Class IRI="#Eraser"/><Class IRI="#BasicTool"/></SubClassOf>
    <SubClassOf><Class IRI="#Notebook"/><Class IRI="#BasicTool"/></SubClassOf>
    <SubClassOf><Class IRI="#Pencil"/><Class IRI="#BasicTool"/></SubClassOf>
    <SubClassOf><Class IRI="#Calculator"/><Class IRI="#CalculationTool"/></SubClassOf>
    <SubClassOf><Class IRI="#Compass"/><Class IRI="#GeometryTool"/></SubClassOf>
    <SubClassOf><Class IRI="#Ruler"/><Class IRI="#GeometryTool"/></SubClassOf>
    <SubClassOf><Class IRI="#SetSquare"/><Class IRI="#GeometryTool"/></SubClassOf>

    <!-- CalculationMethod -->
    <SubClassOf><Class IRI="#Hands"/><Class IRI="#CalculationMethod"/></SubClassOf>
    <SubClassOf><Class IRI="#Mind"/><Class IRI="#CalculationMethod"/></SubClassOf>

    <!-- MathematicalConcept -->
    <SubClassOf><Class IRI="#GeometricShape"/><Class IRI="#MathematicalConcept"/></SubClassOf>
    <SubClassOf><Class IRI="#Magnitude"/><Class IRI="#MathematicalConcept"/></SubClassOf>
    <SubClassOf><Class IRI="#MathOperation"/><Class IRI="#MathematicalConcept"/></SubClassOf>
    <SubClassOf><Class IRI="#Number"/><Class IRI="#MathematicalConcept"/></SubClassOf>
    <SubClassOf><Class IRI="#Circle"/><Class IRI="#GeometricShape"/></SubClassOf>
    <SubClassOf><Class IRI="#Square"/><Class IRI="#GeometricShape"/></SubClassOf>
    <SubClassOf><Class IRI="#Triangle"/><Class IRI="#GeometricShape"/></SubClassOf>
    <SubClassOf><Class IRI="#Bigger"/><Class IRI="#Magnitude"/></SubClassOf>
    <SubClassOf><Class IRI="#Equal"/><Class IRI="#Magnitude"/></SubClassOf>
    <SubClassOf><Class IRI="#Smaller"/><Class IRI="#Magnitude"/></SubClassOf>
    <SubClassOf><Class IRI="#Addition"/><Class IRI="#MathOperation"/></SubClassOf>
    <SubClassOf><Class IRI="#Subtraction"/><Class IRI="#MathOperation"/></SubClassOf>

    <!-- Needs -->
    <SubClassOf><Class IRI="#HelpNeed"/><Class IRI="#Needs"/></SubClassOf>
    <SubClassOf><Class IRI="#MentalNeed"/><Class IRI="#Needs"/></SubClassOf>
    <SubClassOf><Class IRI="#ValidationNeed"/><Class IRI="#Needs"/></SubClassOf>
    <SubClassOf><Class IRI="#DoNotUnderstand"/><Class IRI="#HelpNeed"/></SubClassOf>
    <SubClassOf><Class IRI="#NeedBreak"/><Class IRI="#MentalNeed"/></SubClassOf>
    <SubClassOf><Class IRI="#Tired"/><Class IRI="#MentalNeed"/></SubClassOf>
    <SubClassOf><Class IRI="#TooMuchNoise"/><Class IRI="#MentalNeed"/></SubClassOf>
    <SubClassOf><Class IRI="#IFinish"/><Class IRI="#ValidationNeed"/></SubClassOf>
    <SubClassOf><Class IRI="#IUnderstand"/><Class IRI="#ValidationNeed"/></SubClassOf>
    <SubClassOf><Class IRI="#IsItGood"/><Class IRI="#ValidationNeed"/></SubClassOf>

    <!-- =================================================================
         DISJOINT CLASSES
         ================================================================= -->

    <!-- Top-level categories: mutually disjoint -->
    <DisjointClasses>
        <Class IRI="#Actions"/>
        <Class IRI="#CalculationMethod"/>
        <Class IRI="#MathematicalConcept"/>
        <Class IRI="#Needs"/>
        <Class IRI="#Person"/>
        <Class IRI="#SchoolMaterial"/>
    </DisjointClasses>

    <!-- Person subtypes -->
    <DisjointClasses>
        <Class IRI="#Assistant"/>
        <Class IRI="#Student"/>
        <Class IRI="#Teacher"/>
    </DisjointClasses>

    <!-- Actions subtypes -->
    <DisjointClasses>
        <Class IRI="#ManualAction"/>
        <Class IRI="#MathAction"/>
    </DisjointClasses>
    <DisjointClasses>
        <Class IRI="#Calculate"/>
        <Class IRI="#Count"/>
        <Class IRI="#Draw"/>
        <Class IRI="#Measure"/>
    </DisjointClasses>
    <DisjointClasses>
        <Class IRI="#Cut"/>
        <Class IRI="#Erase"/>
        <Class IRI="#Write"/>
    </DisjointClasses>

    <!-- SchoolMaterial subtypes -->
    <DisjointClasses>
        <Class IRI="#BasicTool"/>
        <Class IRI="#CalculationTool"/>
        <Class IRI="#GeometryTool"/>
    </DisjointClasses>
    <DisjointClasses>
        <Class IRI="#Eraser"/>
        <Class IRI="#Notebook"/>
        <Class IRI="#Pencil"/>
    </DisjointClasses>
    <DisjointClasses>
        <Class IRI="#Compass"/>
        <Class IRI="#Ruler"/>
        <Class IRI="#SetSquare"/>
    </DisjointClasses>

    <!-- CalculationMethod subtypes -->
    <DisjointClasses>
        <Class IRI="#Hands"/>
        <Class IRI="#Mind"/>
    </DisjointClasses>

    <!-- MathematicalConcept subtypes -->
    <DisjointClasses>
        <Class IRI="#GeometricShape"/>
        <Class IRI="#Magnitude"/>
        <Class IRI="#MathOperation"/>
        <Class IRI="#Number"/>
    </DisjointClasses>
    <DisjointClasses>
        <Class IRI="#Circle"/>
        <Class IRI="#Square"/>
        <Class IRI="#Triangle"/>
    </DisjointClasses>
    <DisjointClasses>
        <Class IRI="#Bigger"/>
        <Class IRI="#Equal"/>
        <Class IRI="#Smaller"/>
    </DisjointClasses>
    <DisjointClasses>
        <Class IRI="#Addition"/>
        <Class IRI="#Subtraction"/>
    </DisjointClasses>

    <!-- Needs subtypes -->
    <DisjointClasses>
        <Class IRI="#HelpNeed"/>
        <Class IRI="#MentalNeed"/>
        <Class IRI="#ValidationNeed"/>
    </DisjointClasses>
    <DisjointClasses>
        <Class IRI="#IFinish"/>
        <Class IRI="#IUnderstand"/>
        <Class IRI="#IsItGood"/>
    </DisjointClasses>
    <DisjointClasses>
        <Class IRI="#NeedBreak"/>
        <Class IRI="#Tired"/>
        <Class IRI="#TooMuchNoise"/>
    </DisjointClasses>

    <!-- =================================================================
         OBJECT PROPERTY AXIOMS
         ================================================================= -->

    <!-- Sub-properties -->
    <SubObjectPropertyOf>
        <ObjectProperty IRI="#appliesToConcept"/>
        <ObjectProperty abbreviatedIRI="owl:topObjectProperty"/>
    </SubObjectPropertyOf>
    <SubObjectPropertyOf>
        <ObjectProperty IRI="#isAppliedIn"/>
        <ObjectProperty abbreviatedIRI="owl:topObjectProperty"/>
    </SubObjectPropertyOf>
    <SubObjectPropertyOf>
        <ObjectProperty IRI="#isPerformedBy"/>
        <ObjectProperty abbreviatedIRI="owl:topObjectProperty"/>
    </SubObjectPropertyOf>
    <SubObjectPropertyOf>
        <ObjectProperty IRI="#isRequestedBy"/>
        <ObjectProperty abbreviatedIRI="owl:topObjectProperty"/>
    </SubObjectPropertyOf>
    <SubObjectPropertyOf>
        <ObjectProperty IRI="#isUsedIn"/>
        <ObjectProperty abbreviatedIRI="owl:topObjectProperty"/>
    </SubObjectPropertyOf>
    <SubObjectPropertyOf>
        <ObjectProperty IRI="#performsAction"/>
        <ObjectProperty abbreviatedIRI="owl:topObjectProperty"/>
    </SubObjectPropertyOf>
    <SubObjectPropertyOf>
        <ObjectProperty IRI="#requestHelpFrom"/>
        <ObjectProperty abbreviatedIRI="owl:topObjectProperty"/>
    </SubObjectPropertyOf>
    <SubObjectPropertyOf>
        <ObjectProperty IRI="#usesSupply"/>
        <ObjectProperty abbreviatedIRI="owl:topObjectProperty"/>
    </SubObjectPropertyOf>

    <!-- Inverse pairs -->
    <InverseObjectProperties>
        <ObjectProperty IRI="#appliesToConcept"/>
        <ObjectProperty IRI="#isAppliedIn"/>
    </InverseObjectProperties>
    <InverseObjectProperties>
        <ObjectProperty IRI="#isPerformedBy"/>
        <ObjectProperty IRI="#performsAction"/>
    </InverseObjectProperties>
    <InverseObjectProperties>
        <ObjectProperty IRI="#isRequestedBy"/>
        <ObjectProperty IRI="#requestHelpFrom"/>
    </InverseObjectProperties>
    <InverseObjectProperties>
        <ObjectProperty IRI="#isUsedIn"/>
        <ObjectProperty IRI="#usesSupply"/>
    </InverseObjectProperties>

    <!-- DESIGN: Removed FunctionalObjectProperty(isPerformedBy) and
         InverseFunctionalObjectProperty(performsAction). At the class level
         an action type can be performed by multiple person types, so forcing
         a functional constraint produces inconsistency when the reasoner
         processes class-level individuals. -->

    <!-- Asymmetric properties.
         DESIGN: IrreflexiveObjectProperty omitted for all six properties that had it.
         In OWL 2, an asymmetric property cannot be reflexive (if P(a,a) held then
         P(a,a) would violate asymmetry), so IrreflexiveObjectProperty is logically
         entailed by AsymmetricObjectProperty and the declaration is redundant. -->
    <AsymmetricObjectProperty><ObjectProperty IRI="#appliesToConcept"/></AsymmetricObjectProperty>
    <AsymmetricObjectProperty><ObjectProperty IRI="#isAppliedIn"/></AsymmetricObjectProperty>
    <AsymmetricObjectProperty><ObjectProperty IRI="#isRequestedBy"/></AsymmetricObjectProperty>
    <AsymmetricObjectProperty><ObjectProperty IRI="#isUsedIn"/></AsymmetricObjectProperty>
    <AsymmetricObjectProperty><ObjectProperty IRI="#requestHelpFrom"/></AsymmetricObjectProperty>
    <AsymmetricObjectProperty><ObjectProperty IRI="#usesSupply"/></AsymmetricObjectProperty>

    <!-- Domains -->
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#appliesToConcept"/>
        <Class IRI="#Actions"/>
    </ObjectPropertyDomain>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#isAppliedIn"/>
        <Class IRI="#MathematicalConcept"/>
    </ObjectPropertyDomain>
    <!-- DESIGN: two separate ObjectPropertyDomain declarations for the same property
         are interpreted as intersection by OWL semantics, yielding an empty domain
         when the two classes are disjoint. ObjectUnionOf is the correct encoding. -->
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#isPerformedBy"/>
        <ObjectUnionOf>
            <Class IRI="#Actions"/>
            <Class IRI="#Needs"/>
        </ObjectUnionOf>
    </ObjectPropertyDomain>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#isRequestedBy"/>
        <ObjectUnionOf>
            <Class IRI="#Assistant"/>
            <Class IRI="#Teacher"/>
        </ObjectUnionOf>
    </ObjectPropertyDomain>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#isUsedIn"/>
        <Class IRI="#SchoolMaterial"/>
    </ObjectPropertyDomain>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#performsAction"/>
        <Class IRI="#Person"/>
    </ObjectPropertyDomain>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#requestHelpFrom"/>
        <Class IRI="#Student"/>
    </ObjectPropertyDomain>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#usesSupply"/>
        <Class IRI="#Actions"/>
    </ObjectPropertyDomain>

    <!-- Ranges -->
    <ObjectPropertyRange>
        <ObjectProperty IRI="#appliesToConcept"/>
        <Class IRI="#MathematicalConcept"/>
    </ObjectPropertyRange>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#isAppliedIn"/>
        <Class IRI="#Actions"/>
    </ObjectPropertyRange>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#isPerformedBy"/>
        <Class IRI="#Person"/>
    </ObjectPropertyRange>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#isRequestedBy"/>
        <Class IRI="#Student"/>
    </ObjectPropertyRange>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#isUsedIn"/>
        <Class IRI="#Actions"/>
    </ObjectPropertyRange>
    <!-- DESIGN: same intersection-as-union bug for ranges, fixed with ObjectUnionOf -->
    <ObjectPropertyRange>
        <ObjectProperty IRI="#performsAction"/>
        <ObjectUnionOf>
            <Class IRI="#Actions"/>
            <Class IRI="#Needs"/>
        </ObjectUnionOf>
    </ObjectPropertyRange>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#requestHelpFrom"/>
        <ObjectUnionOf>
            <Class IRI="#Assistant"/>
            <Class IRI="#Teacher"/>
        </ObjectUnionOf>
    </ObjectPropertyRange>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#usesSupply"/>
        <Class IRI="#SchoolMaterial"/>
    </ObjectPropertyRange>

    <!-- =================================================================
         FRENCH LABELS (rdfs:label @fr) — Step 2
         ================================================================= -->

    <!-- People -->
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Student</IRI>
        <Literal xml:lang="fr">élève</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Teacher</IRI>
        <Literal xml:lang="fr">professeur</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Teacher</IRI>
        <Literal xml:lang="fr">maître</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Teacher</IRI>
        <Literal xml:lang="fr">maîtresse</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Assistant</IRI>
        <Literal xml:lang="fr">assistant</Literal>
    </AnnotationAssertion>

    <!-- Actions -->
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Draw</IRI>
        <Literal xml:lang="fr">tracer</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Draw</IRI>
        <Literal xml:lang="fr">dessiner</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Calculate</IRI>
        <Literal xml:lang="fr">calculer</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Count</IRI>
        <Literal xml:lang="fr">compter</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Measure</IRI>
        <Literal xml:lang="fr">mesurer</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Write</IRI>
        <Literal xml:lang="fr">écrire</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Erase</IRI>
        <Literal xml:lang="fr">effacer</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Cut</IRI>
