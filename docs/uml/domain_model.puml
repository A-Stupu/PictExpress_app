@startuml domain_model
title Pict'Express — Domain Model (Elaboration Phase)

skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor LightYellow
  BorderColor DarkGray
}

class Sentence {
  text: String
  language: "fr"
}

class Lemma {
  value: String
}

class OWLConcept {
  className: String
  labelFR: String
  arasaacId: Integer
}

class Action {
  <<subtype of OWLConcept>>
  Draw, Write, Calculate, Erase
  Measure, Count, Cut
}

class MathematicalConcept {
  <<subtype of OWLConcept>>
  Circle, Square, Triangle
  Rectangle, Pentagon, Hexagon
  Addition, Subtraction
  Multiplication, Division
}

class SchoolMaterial {
  <<subtype of OWLConcept>>
  Compass, Pencil, Ruler
  SetSquare, Eraser, Notebook, Calculator
}

class Need {
  <<subtype of OWLConcept>>
  PhysicalNeed, MentalNeed
  HelpNeed, ValidationNeed
}

class Pictogram {
  arasaacId: Integer
  labelFR: String
  imageURL: String
}

class InferenceRule {
  <<SWRL DLSafeRule>>
  antecedent: String
  consequent: String
}

class User {
  role: Teacher | Student | Assistant
}

User "1" --> "1..*" Sentence     : pronounces (Flow 1)
Sentence "1" *-- "1..*" Lemma   : lemmatised into
Lemma "0..1" --> "0..1" OWLConcept : mapped to
OWLConcept "1" --> "0..1" Pictogram : identified by arasaacId

OWLConcept <|-- Action
OWLConcept <|-- MathematicalConcept
OWLConcept <|-- SchoolMaterial
OWLConcept <|-- Need

Action "0..*" -- "0..*" MathematicalConcept : hasTarget (runtime)
Action "0..*" --> "0..*" SchoolMaterial     : requires (inferred)

InferenceRule ..> Action              : triggers on
InferenceRule ..> MathematicalConcept : triggers on
InferenceRule ..> SchoolMaterial      : produces

User "0..*" --> "0..*" Need      : selects (Flow 2)
Need "1" --> "1" Pictogram       : shown as

note top of InferenceRule
  17 DLSafeRule axioms in maths.owl
  loaded via ElementTree at boot,
  executed by Pellet JVM.
end note

note bottom of Pictogram
  Flow 1: served by FastAPI StaticFiles
  Flow 2: loaded from ARASAAC CDN directly
end note

@enduml
