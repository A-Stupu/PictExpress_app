@startuml Use_Case_Diagram
title Pict'Express — Use Case Diagram (Implemented, Elaboration Phase)

left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor LightYellow
  BorderColor DarkOrange
}

' ─── ACTORS ───────────────────────────────────────────────────────────────
actor "Teacher\n(Enseignant)"       as Teacher
actor "Student\n(Élève)"            as Student
actor "Assistant\n(AESH)"           as Assistant <<optional>>
actor "ARASAAC CDN"                 as ARASAAC <<external system>>

' Assistant can perform all Teacher use cases (optional substitution)
Assistant ..|> Teacher

' ─── SYSTEM BOUNDARY ──────────────────────────────────────────────────────
rectangle "Pict'Express (implemented)" {

  package "Flow 1 — Teacher → Pictograms" {
    usecase "UC1: Convert spoken\nsentence to pictograms"  as UC1
    usecase "UC2: Record voice input"                       as UC2
    usecase "UC3: Transcribe speech\n(Whisper fr)"          as UC3
    usecase "UC4: Lemmatise text\n(spaCy)"                  as UC4
    usecase "UC5: Infer required tools\nvia SWRL/Pellet"    as UC5
    usecase "UC6: Display suggested\npictograms"            as UC6
  }

  package "Flow 2 — Student → Communication" {
    usecase "UC7: Open communication\nboard"                as UC7
    usecase "UC8: Select need\npictogram"                   as UC8
    usecase "UC9: View pictogram\nfull-screen"              as UC9
  }

  package "System Startup" {
    usecase "UC10: Load OWL ontology\n+ Pellet reasoner"    as UC10
    usecase "UC11: Download missing\npictograms from CDN"   as UC11
  }

}

' ─── ACTOR → USE CASE ─────────────────────────────────────────────────────
Teacher --> UC1
Teacher --> UC6
Student --> UC7
Student --> UC8
Student --> UC9

' ─── INCLUDE / EXTEND ─────────────────────────────────────────────────────
UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC1 ..> UC5 : <<extend>>
UC1 ..> UC6 : <<include>>

UC7 ..> UC8 : <<include>>
UC8 ..> UC9 : <<include>>

UC10 ..> UC11 : <<include>>

' ─── EXTERNAL SYSTEMS ─────────────────────────────────────────────────────
UC11 --> ARASAAC : PNG download\n(static CDN)
UC9  --> ARASAAC : Image.network\n(static CDN)

note bottom of Assistant
  Assistant currently shares all
  Teacher use cases. No dedicated
  UC implemented yet.
end note

note right of UC5
  OntologyService.infer_pictograms()
  creates temp OWL individuals,
  runs sync_reasoner_pellet(),
  collects requires property values.
end note

@enduml
